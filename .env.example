# DeepSeek API (optional)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 推送方式：qmsg（QQ酱，推荐QQ） / serverchan（Server酱） / wecom / pushplus / none
# 旧的 WECHAT_PUSH_TYPE 仍兼容，不设置 PUSH_TYPE 时会读取它
PUSH_TYPE=qmsg

# QQ Qmsg酱：到 https://qmsg.zendee.cn QQ 登录后获取 Key，并填你的 QQ 号
QMSG_KEY=
QMSG_QQ=

# Server酱 SendKey
SERVERCHAN_SENDKEY=

# WeCom group robot webhook
WECOM_WEBHOOK_URL=

# PushPlus token
PUSHPLUS_TOKEN=

# State file
STATE_FILE=state.json
